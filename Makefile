# --- Настройки компилятора ---
CC = gcc

# Флаги компиляции (CFLAGS):
# -std=c++17       - используем стандарт C++17
# -Wall -Wextra    - включаем все основные предупреждения компилятора
# -fPIC            - генерируем позиционно-независимый код (обязательно для динамических .so библиотек)
# -pthread         - поддержка многопоточности (для std::thread, std::mutex)
CFLAGS = -std=c++17 -Wall -Wextra -fPIC -pthread

# Флаги линковки (LDFLAGS):
# -pthread         - линкуем библиотеку потоков POSIX
# -lstdc++         - линкуем стандартную библиотеку C++ (так как используем gcc, а не g++)
LDFLAGS = -pthread -lstdc++

# --- Структура директорий ---
SRC_LIB_DIR = src/LogLib
SRC_APP_DIR = src/TestApp
BUILD_DIR   = build
INC_DIR     = src/LogLib  # Папка с заголовочными файлами (.h)

# --- Поиск исходных файлов ---
# Функция wildcard автоматически находит все .cpp файлы в указанных директориях.
LIB_SRCS = $(wildcard $(SRC_LIB_DIR)/*.cpp)
APP_SRCS = $(SRC_APP_DIR)/Test.cpp

# --- Формирование имен объектных файлов (.o) ---
# Мы складываем все .o файлы в папку build/, чтобы не засорять папку src/ исходниками.
# Используем patsubst (замена по шаблону) для изменения пути и расширения.
# Пример: src/LogLib/Log.cpp -> build/Log.o
LIB_OBJS = $(patsubst $(SRC_LIB_DIR)/%.cpp, $(BUILD_DIR)/%.o, $(LIB_SRCS))
APP_OBJS = $(BUILD_DIR)/Test.o

# --- Имена целевых файлов ---
# Динамическая библиотека в Linux имеет расширение .so и обязательно префикс lib
LIB_NAME = $(BUILD_DIR)/libLogLib.so
# Исполняемый файл приложения
APP_NAME = $(BUILD_DIR)/TestLogApp

# ==============================================================================
# ЦЕЛИ СБОРКИ
# ==============================================================================

# .PHONY указывает, что эти цели не являются именами реальных файлов.
.PHONY: all lib app clean run

# Цель по умолчанию (если в терминале просто написать 'make' без аргументов)
all: lib app

# --- Раздельная цель для сборки только библиотеки ---
lib: $(LIB_NAME)

# --- Раздельная цель для сборки только приложения ---
# Приложение зависит от библиотеки, поэтому при сборке 'make app' 
# make сначала проверит и соберет библиотеку, если она не актуальна.
app: $(APP_NAME)

# ==============================================================================
# ПРАВИЛА СБОРКИ (Рецепты)
# ==============================================================================

# --- Сборка динамической библиотеки (.so) ---
# Автоматические переменные make:
# $@ - имя целевого файла (в данном случае $(LIB_NAME))
# $^ - имена всех зависимостей (все .o файлы библиотеки)
$(LIB_NAME): $(LIB_OBJS)
	@mkdir -p $(BUILD_DIR)
	$(CC) -shared -o $@ $^ $(LDFLAGS)

# --- Сборка исполняемого файла приложения ---
# -L$(BUILD_DIR)  - указываем линковщику, в какой папке искать библиотеки
# -lLogLib        - подключаем нашу библиотеку (имя без префикса lib и расширения .so)
# -Wl,-rpath,'$$ORIGIN' - заставляет приложение искать .so 
#                         в той же папке, где лежит сам исполняемый файл (в build/).
#                         Без этого флага программа не нашла бы библиотеку при запуске,
#                         и пришлось бы вручную экспортировать переменную LD_LIBRARY_PATH.
$(APP_NAME): $(APP_OBJS) $(LIB_NAME)
	@mkdir -p $(BUILD_DIR)
	$(CC) -o $@ $(APP_OBJS) -L$(BUILD_DIR) -lLogLib $(LDFLAGS) -Wl,-rpath,'$$ORIGIN'

# --- Компиляция исходников библиотеки в объектные файлы ---
# Шаблонное правило: для любого файла build/%.o ищем исходник в src/LogLib/%.cpp
# $< - имя первой зависимости (исходный .cpp файл)
$(BUILD_DIR)/%.o: $(SRC_LIB_DIR)/%.cpp
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -I$(INC_DIR) -c $< -o $@

# --- Компиляция Test.cpp в объектный файл ---
$(APP_OBJS): $(APP_SRCS)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -I$(INC_DIR) -c $< -o $@

# --- Цель для запуска приложения (удобно для тестирования) ---
run: app
	./$(APP_NAME)

# --- Цель для очистки проекта от мусора ---
# Удаляем всю папку build со всеми объектным файлами, .so и исполняемым файлом.
# Папки src/ остаются нетронутыми (требование "никакого мусора в исходниках" выполнено).
clean:
	rm -rf $(BUILD_DIR)
	